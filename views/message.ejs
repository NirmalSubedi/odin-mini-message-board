<%- include('header') %>

    <main class="main message-details">
        <p class="username">
            <%= message.username %>
        </p>
        <p class="post-time">
            <%= message.post_time.toLocaleString() %>
        </p>
        <p class="message">
            <%= message.message %>
        </p>
    </main>

    <%- include('footer') %>