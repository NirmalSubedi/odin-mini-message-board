<% messages.forEach((message,index)=> { %>
    <section class="message">
        <p class="user">
            <%= message.user %>
        </p>
        <p class="text">
            <%= message.text %>
        </p>
        <p class="time">
            <%= message.time %>
        </p>
        <a href="message/<%= index %>">View Details</a>
    </section>
    <% }) %>