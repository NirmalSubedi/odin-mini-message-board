<% messages.forEach((message,index)=> { %>
    <section class="message-post">
        <p class="username">
            <%= message.username %>
        </p>
        <p class="post-time">
            <%= message.post_time.toLocaleString() %>
        </p>
        <p class="message">
            <%= message.message %>
        </p>
        <a href="message/<%= message.id %>" class="message-details">View Details</a>
    </section>
    <% }) %>