<%- include('header', {title}) %>
  <main class="main">
    <h1>
      <%= title %>
    </h1>
    <% if (messages.length> 0) { %>
      <%- include('messages', {messages}) %>

        <% } else { %>
          <p class="empty-board">No messages currently. Be the first message! :)</p>
          <% } %>
            <a href="/new" class="create">Create Message</a>
  </main>
  <%- include('footer') %>