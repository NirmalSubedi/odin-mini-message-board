<%- include('header', {title}) %>
  <h1 class="heading form-heading">
    <%= title %>
  </h1>
  <main class="main">
    <%- include('messages') %>
      <form action="/new" method="post" class="message-form">
        <div class="form-field">
          <label for="messageUser">Username</label>
          <input type="text" name="messageUser" id="messageUser" class="messageUser" autofocus>
        </div>

        <div class="form-field">
          <label for="messageText">Message</label>
          <textarea name="messageText" id="messageText" class="messageText" cols="30" rows="4"></textarea>
        </div>

        <button type="submit" class="submit">Send Message</button>
      </form>
  </main>

  <%- include('footer') %>