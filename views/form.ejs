<%- include('header', {title}) %>
  <h1 class="heading form-heading">
    <%= title %>
  </h1>
  <main class="main">
    <%- include('messages') %>
      <form action="/new" method="post" class="message-form">
        <div class="form-field">
          <label for="message-user">Username</label>
          <input type="text" name="messageUser" id="message-user" class="message-user" autofocus>
        </div>

        <div class="form-field">
          <label for="message-text">Message</label>
          <textarea name="messageText" id="message-text" class="message-text" cols="30" rows="4"></textarea>
        </div>

        <button type="submit" class="submit">Send Message</button>
      </form>
  </main>

  <%- include('footer') %>